# Source allowlist. Everything else is local runtime state by default.
*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD-PARTY-NOTICES.md
!/team-gateway.cjs
!/hub-admin.py
!/issue-login-link.cjs
!/update-clis.py
!/watchdog.py
!/portal/
!/portal/*.cjs
!/portal/package.json
!/portal/package-lock.json
!/portal/public/
!/portal/public/*.js
!/portal/public/*.css
!/portal/public/*.svg
!/assets/
!/assets/*.png
!/assets/*.mp4
!/onboarding/
!/onboarding/*.sh
!/tests/
!/tests/*.py
!/tests/*.cjs
!/scripts/
!/scripts/*.py
!/scripts/*.cjs
!/scripts/t3-claude-plan.md
!/examples/
!/examples/*.example.json
!/examples/*.example.yaml
!/examples/launchd/
!/examples/launchd/*.plist.example
!/upstream/
!/upstream/sources.json
!/upstream/patches/
!/upstream/patches/*.patch
!/upstream/licenses/
!/upstream/licenses/*-LICENSE
