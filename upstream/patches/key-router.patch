@@ -0,0 +1,252 @@
+package main
+
+import (
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/json"
+	"io"
+	"math"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+const quotaMaxAge = 3 * time.Minute
+
+type quotaWindow struct {
+	Label           string     `json:"label"`
+	Scope           string     `json:"scope"`
+	DurationSeconds int        `json:"durationSeconds"`
+	Remaining       *float64   `json:"remaining"`
+	ResetsAt        *time.Time `json:"resetsAt"`
+}
+
+type accountQuota struct {
+	Provider     string        `json:"provider"`
+	CheckedAt    time.Time     `json:"checkedAt"`
+	Windows      []quotaWindow `json:"windows"`
+	ResetCredits *resetCredits `json:"resetCredits,omitempty"`
+}
+
+type resetCredits struct {
+	CheckedAt      time.Time   `json:"checkedAt"`
+	AvailableCount int         `json:"availableCount"`
+	Expirations    []time.Time `json:"expirations"`
+}
+
+type quotaSnapshot struct {
+	Version  int                     `json:"version"`
+	Accounts map[string]accountQuota `json:"accounts"`
+}
+
+var quotaCache struct {
+	sync.Mutex
+	path   string
+	readAt time.Time
+	value  quotaSnapshot
+}
+
+func defaultUsageFile() string {
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return ""
+	}
+	return filepath.Join(home, ".local", "share", "cliproxy-hub", "routing-usage.json")
+}
+
+func readQuotaSnapshot(path string, now time.Time) quotaSnapshot {
+	quotaCache.Lock()
+	defer quotaCache.Unlock()
+	if quotaCache.path == path && now.Sub(quotaCache.readAt) >= 0 && now.Sub(quotaCache.readAt) < time.Second {
+		return quotaCache.value
+	}
+	value := quotaCache.value
+	if quotaCache.path != path {
+		value = quotaSnapshot{}
+	}
+	if file, err := os.Open(path); err == nil {
+		defer file.Close()
+		// Quotas are hints only. A missing, oversized or malformed snapshot
+		// must never bypass permissions or turn a provider outage into lockout.
+		if raw, err := io.ReadAll(io.LimitReader(file, 1024*1024+1)); err == nil && len(raw) <= 1024*1024 {
+			var next quotaSnapshot
+			if json.Unmarshal(raw, &next) == nil && next.Version == 1 && len(next.Accounts) <= 1000 {
+				value = next
+			}
+		}
+	}
+	quotaCache.path, quotaCache.readAt, quotaCache.value = path, now, value
+	return value
+}
+
+// Scores are admission hints, not a token-capacity estimate. The tightest
+// relevant quota controls the weight; reset urgency contributes at most 25%.
+func quotaScore(candidate pluginapi.SchedulerAuthCandidate, model string, snapshot quotaSnapshot, now time.Time) (float64, bool, float64) {
+	headroom, known := quotaHeadroom(candidate, model, snapshot, now)
+	if !known {
+		return 0, false, headroom
+	}
+	weight := math.Inf(1)
+	quota := snapshot.Accounts[candidate.ID]
+	for _, window := range quota.Windows {
+		if !validQuotaWindow(window, candidate.Provider, model, quota.CheckedAt, now) {
+			continue
+		}
+		r := math.Max(0, (*window.Remaining/100-0.03)/0.97)
+		urgency := 0.0
+		if window.ResetsAt != nil {
+			horizon := 30 * time.Minute
+			if window.DurationSeconds >= 604800 || window.Label == "1w" || window.Label == "Opus" || window.Label == "Sonnet" || window.Label == "Fable" {
+				horizon = 6 * time.Hour
+			}
+			if window.DurationSeconds >= 2419200 || window.Label == "1mo" {
+				horizon = 24 * time.Hour
+			}
+			urgency = math.Max(0, math.Min(1, 1-window.ResetsAt.Sub(now).Seconds()/horizon.Seconds()))
+		}
+		weight = math.Min(weight, math.Pow(r, 1.5)*(1+0.25*urgency))
+	}
+	return math.Max(0.0025, weight) * bankedResetMultiplier(candidate.Provider, quota.ResetCredits, now), true, headroom
+}
+
+// Banked resets favor new sessions on accounts whose credits will expire soon.
+// They are not usable quota: zero exclusion and the admission reserve still
+// apply, and selection never redeems a credit or moves a healthy binding.
+func bankedResetMultiplier(provider string, credits *resetCredits, now time.Time) float64 {
+	if provider != "codex" || credits == nil || credits.AvailableCount <= 0 || credits.AvailableCount > 1000 ||
+		credits.CheckedAt.IsZero() || now.Sub(credits.CheckedAt) > 15*time.Minute || credits.CheckedAt.After(now.Add(5*time.Second)) ||
+		len(credits.Expirations) > 1000 {
+		return 1
+	}
+	expirations := append([]time.Time(nil), credits.Expirations...)
+	sort.Slice(expirations, func(i, j int) bool { return expirations[i].Before(expirations[j]) })
+	urgency, available := 0.0, credits.AvailableCount
+	for _, expiration := range expirations {
+		if !expiration.After(now) {
+			continue
+		}
+		if available == 0 {
+			break
+		}
+		available--
+		urgency += math.Max(0, 1-expiration.Sub(now).Hours()/(7*24))
+	}
+	return 1 + math.Min(3, 2*urgency)
+}
+
+func validQuotaWindow(window quotaWindow, provider, model string, checkedAt, now time.Time) bool {
+	relevant := relevantWindow(window.Label, provider, model)
+	if window.Scope != "" {
+		relevant = false
+		if window.Scope == "general" {
+			relevant = true
+		}
+		if provider == "claude" && window.Scope == claudeModelFamily(model) {
+			relevant = true
+		}
+	}
+	return relevant && window.Remaining != nil &&
+		!math.IsNaN(*window.Remaining) && !math.IsInf(*window.Remaining, 0) && *window.Remaining >= 0 && *window.Remaining <= 100 &&
+		!(window.ResetsAt != nil && !window.ResetsAt.After(now) && checkedAt.Before(*window.ResetsAt))
+}
+
+// Exponential races implement weighted random sampling with a stable hash.
+// Candidate order and process restarts do not change the random draw. Bindings
+// still pin the result when quota weights change during a conversation.
+func weightedAccount(candidates []pluginapi.SchedulerAuthCandidate, model, namespace string, snapshot quotaSnapshot, now time.Time) string {
+	weights := make([]float64, len(candidates))
+	known := make([]bool, len(candidates))
+	headrooms := make([]float64, len(candidates))
+	healthy, totalKnown, unknown := false, 0.0, 0
+	for i, candidate := range candidates {
+		weights[i], known[i], headrooms[i] = quotaScore(candidate, model, snapshot, now)
+		if known[i] && headrooms[i] > 3 {
+			healthy = true
+		}
+	}
+	for i := range candidates {
+		if known[i] {
+			if healthy && headrooms[i] <= 3 {
+				weights[i] = 0
+			}
+			totalKnown += weights[i]
+		} else {
+			unknown++
+		}
+	}
+	choice, best := "", math.Inf(1)
+	for i, candidate := range candidates {
+		weight := weights[i]
+		if !known[i] {
+			weight = 1
+			// Unknown accounts together get at most 20% of new starts when
+			// fresh healthy alternatives exist; feed outages never lock out.
+			if healthy {
+				weight = totalKnown * 0.25 / float64(unknown)
+			}
+		}
+		if weight <= 0 {
+			continue
+		}
+		digest := sha256.Sum256([]byte(namespace + "\x00" + candidate.ID))
+		u := (float64(binary.BigEndian.Uint64(digest[:8])>>12) + 1) / (float64(uint64(1)<<52) + 1)
+		race := -math.Log(u) / weight
+		if race < best || (race == best && candidate.ID < choice) {
+			choice, best = candidate.ID, race
+		}
+	}
+	return choice
+}
+
+func relevantWindow(label, provider, model string) bool {
+	switch label {
+	case "5h", "1w", "1mo":
+		return true
+	case "Opus", "Sonnet", "Fable":
+		return provider == "claude" && claudeModelFamily(model) == strings.ToLower(label)
+	default:
+		return false
+	}
+}
+
+// Keep legacy aliases explicit: this identifier is registered by the host.
+// Unknown model names use general windows without guessing a scoped family.
+func claudeModelFamily(model string) string {
+	model = canonicalModel(model)
+	if model == "claude-3-7-sonnet-20250219" {
+		return "sonnet"
+	}
+	for _, family := range []string{"opus", "sonnet", "fable"} {
+		if model == "claude-"+family || strings.HasPrefix(model, "claude-"+family+"-") {
+			return family
+		}
+	}
+	return ""
+}
+
+// quotaHeadroom returns the smallest applicable percentage. Every applicable
+// window constrains a request: a full weekly bucket cannot override an empty
+// five-hour bucket, and an empty Sonnet bucket does not block Opus.
+func quotaHeadroom(candidate pluginapi.SchedulerAuthCandidate, model string, snapshot quotaSnapshot, now time.Time) (float64, bool) {
+	quota, ok := snapshot.Accounts[candidate.ID]
+	if !ok || quota.Provider != candidate.Provider || quota.CheckedAt.IsZero() ||
+		now.Sub(quota.CheckedAt) > quotaMaxAge || quota.CheckedAt.After(now.Add(5*time.Second)) {
+		return 0, false
+	}
+	remaining, known := 100.0, false
+	for _, window := range quota.Windows {
+		if !validQuotaWindow(window, candidate.Provider, model, quota.CheckedAt, now) {
+			continue
+		}
+		// A reset crossing invalidates the old observation. Do not invent a
+		// replenished quota; the provider or the next refresh confirms it.
+		known = true
+		remaining = math.Min(remaining, *window.Remaining)
+	}
+	return remaining, known
+}
