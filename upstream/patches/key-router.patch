+func TestHubSessionsRotateThenStayOnAllowedAccount(t *testing.T) {
+	raw, _ := json.Marshal(lifecycleRequest{ConfigYAML: []byte("users:\n  - {name: affinity-test, api-keys: [k], primary: [id=work-a, id=work-b]}\n")})
+	if err := configure(raw); err != nil {
+		t.Fatal(err)
+	}
+	a := pluginapi.SchedulerAuthCandidate{ID: "work-a", Provider: "codex"}
+	b := pluginapi.SchedulerAuthCandidate{ID: "work-b", Provider: "codex"}
+	personal := pluginapi.SchedulerAuthCandidate{ID: "personal", Provider: "codex"}
+	options := func(id string) pluginapi.SchedulerOptions {
+		o := scope("k")
+		o.Headers = map[string][]string{"Session-Id": {id}}
+		return o
+	}
+	first := pick(t, options("one"), personal, a, b)
+	second := pick(t, options("two"), personal, a, b)
+	if first.Reject || second.Reject || first.AuthID == second.AuthID || first.AuthID == "personal" || second.AuthID == "personal" {
+		t.Fatalf("sessions were not distributed across permitted accounts: %+v %+v", first, second)
+	}
+	if again := pick(t, options("one"), personal, b, a); again.AuthID != first.AuthID {
+		t.Fatalf("same session changed accounts: before=%+v after=%+v", first, again)
+	}
+	if lostWork := pick(t, options("one"), personal); !lostWork.Reject {
+		t.Fatalf("team session fell back to personal account: %+v", lostWork)
 	}
 }
 
