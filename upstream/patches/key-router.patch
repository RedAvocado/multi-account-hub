+	remaining := 95.0
+	quota := snapshot.Accounts["work"]
+	quota.Windows = append(quota.Windows, quotaWindow{Label: "5h", Remaining: &remaining, ResetsAt: &soon})
+	snapshot.Accounts["work"] = quota
+	if got, _, _ := quotaScore(candidates[0], "gpt-6-sol", snapshot, now); got != base {
+		t.Fatal("imminent short reset overrode the depleted weekly bottleneck")
+	}
+	quota.Windows = []quotaWindow{{Label: "1w", Remaining: &remaining}}
+	snapshot.Accounts["work"] = quota
+	base, _, _ = quotaScore(candidates[0], "gpt-6-sol", snapshot, now)
+	quota.Windows[0].ResetsAt = &soon
+	snapshot.Accounts["work"] = quota
+	boosted, _, _ := quotaScore(candidates[0], "gpt-6-sol", snapshot, now)
+	if boosted <= base || boosted > base*1.25 {
+		t.Fatal("reset urgency must supply a bounded positive boost")
+	}
+}
