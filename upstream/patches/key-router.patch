+func TestCanonicalAndAnonymousBindingsStayWarmAsQuotasChange(t *testing.T) {
+	now := time.Now()
+	candidates, snapshot := weightedFixture(now, map[string]float64{"a": 80, "b": 40})
+	user := &userConfig{Name: "canonical-affinity-test"}
+	opts := pluginapi.SchedulerOptions{Metadata: map[string]any{"canonical_session_id": "canonical"}, Headers: map[string][]string{"Session-Id": {"header-one"}}}
+	req := pluginapi.SchedulerPickRequest{Provider: "codex", Model: "gpt-6-sol", Options: opts}
+	first, _ := bestForSession(user, req, candidates, nil, snapshot, now)
+	_, changed := weightedFixture(now, map[string]float64{"a": 1, "b": 99})
+	for i := 0; i < 1000; i++ {
+		req.Options.Headers["Session-Id"] = []string{fmt.Sprint(i)}
+		if got, _ := bestForSession(user, req, candidates, nil, changed, now); got != first {
+			t.Fatal("canonical session moved after quota or header changes")
+		}
+	}
+	req.Options = pluginapi.SchedulerOptions{}
+	anonymous, _ := bestForSession(user, req, candidates, nil, snapshot, now)
+	for i := 0; i < 100; i++ {
+		if got, _ := bestForSession(user, req, candidates, nil, changed, now); got != anonymous {
+			t.Fatal("anonymous tool calls must share a sticky binding")
+		}
+	}
+	// Racing first requests must publish one binding under the same lock.
+	req.Options.Metadata = map[string]any{"canonical_session_id": "concurrent-first"}
+	var wg sync.WaitGroup
+	results := make(chan string, 32)
+	for i := 0; i < 32; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			got, _ := bestForSession(user, req, candidates, nil, snapshot, now)
+			results <- got
+		}()
+	}
+	wg.Wait()
+	close(results)
+	first = ""
+	for got := range results {
+		if first == "" {
+			first = got
+		}
+		if got != first {
+			t.Fatal("concurrent first requests split session affinity")
+		}
+	}
+}
