+func TestExactAccountRulesAndScopeCannotBeSpoofed(t *testing.T) {
+	raw, _ := json.Marshal(lifecycleRequest{ConfigYAML: []byte("users:\n  - {name: team, api-keys: [team-key], primary: [id=codex-work.json]}\n")})
+	if err := configure(raw); err != nil {
+		t.Fatal(err)
+	}
+	work := pluginapi.SchedulerAuthCandidate{ID: "codex-work.json", Provider: "codex"}
+	personal := pluginapi.SchedulerAuthCandidate{ID: "codex-work.json-personal", Provider: "codex"}
+	if got := pick(t, scope("team-key"), personal, work); got.AuthID != work.ID {
+		t.Fatalf("team must receive only its exact work credential, got %+v", got)
+	}
+	if got := pick(t, scope("team-key"), personal); !got.Reject {
+		t.Fatalf("similar personal credential must be rejected, got %+v", got)
+	}
+	opts := scope("not-team-key")
+	opts.Headers = map[string][]string{"X-Api-Key": {"team-key"}}
+	if got := pick(t, opts, work); !got.Reject {
+		t.Fatalf("an authenticated scope must not be overridden by a header, got %+v", got)
+	}
+}
