diff --git a/sdk/cliproxy/auth/hub_router_guard_test.go b/sdk/cliproxy/auth/hub_router_guard_test.go
new file mode 100644
index 0000000..a3af6eb
--- /dev/null
+++ b/sdk/cliproxy/auth/hub_router_guard_test.go
@@ -0,0 +1,43 @@
+package auth
+
+import (
+	"context"
+	"testing"
+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+func TestHubGuardRejectsUnavailableScheduler(t *testing.T) {
+	for _, mixed := range []bool{false, true} {
+		for _, scheduler := range []string{"missing", "unhandled"} {
+			m := NewManager(nil, &RoundRobinSelector{}, nil)
+			m.executors["gemini"] = schedulerTestExecutor{}
+			if _, err := m.Register(context.Background(), &Auth{ID: "personal", Provider: "gemini"}); err != nil {
+				t.Fatal(err)
+			}
+			if scheduler == "unhandled" {
+				m.SetPluginScheduler(&fakePluginScheduler{handled: false})
+			}
+			if mixed {
+				if auth, _, _, err := m.pickNextMixed(context.Background(), []string{"gemini"}, "", cliproxyexecutor.Options{}, nil); err == nil || auth != nil {
+					t.Fatalf("mixed %s scheduler unexpectedly returned %v, err=%v", scheduler, auth, err)
+				}
+			} else if auth, _, err := m.pickNext(context.Background(), "gemini", "", cliproxyexecutor.Options{}, nil); err == nil || auth != nil {
+				t.Fatalf("%s scheduler unexpectedly returned %v, err=%v", scheduler, auth, err)
+			}
+		}
+	}
+}
+
+func TestHubGuardAllowsExplicitSchedulerSelection(t *testing.T) {
+	m := NewManager(nil, &RoundRobinSelector{}, nil)
+	m.executors["gemini"] = schedulerTestExecutor{}
+	if _, err := m.Register(context.Background(), &Auth{ID: "work", Provider: "gemini"}); err != nil {
+		t.Fatal(err)
+	}
+	m.SetPluginScheduler(&fakePluginScheduler{handled: true, resp: pluginapi.SchedulerPickResponse{Handled: true, AuthID: "work"}})
+	if a, _, err := m.pickNext(context.Background(), "gemini", "", cliproxyexecutor.Options{}, nil); err != nil || a == nil || a.ID != "work" {
+		t.Fatalf("allowed selection failed: auth=%v err=%v", a, err)
+	}
+}
